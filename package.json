{
  "name": "cutout-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "python -m backend.cutout_studio.server",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "test:backend": "python -m unittest discover -s backend/tests -p \"test_*.py\"",
    "test:frontend": "node scripts/run-ts-tests.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:workflow": "node --test --experimental-strip-types tests/workflowDoctor.test.ts tests/verifyRelease.test.ts",
    "test": "pnpm test:backend && pnpm test:frontend && pnpm typecheck:tests",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "workflow:doctor": "node scripts/workflow-doctor.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.468.0",
    "vite": "^6.0.5",
    "typescript": "^5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2"
  }
}
